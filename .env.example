# Get a free key at https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=

# Auto-filled by Vercel when you add a Blob store to this project
# (Storage tab -> Create Database -> Blob). No need to set manually.
BLOB_READ_WRITE_TOKEN=

# Google OAuth client, from Google Cloud Console -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret Auth.js uses to sign session cookies. Generate one with:
#   openssl rand -base64 33
AUTH_SECRET=
